        port: 5556,
        connectionType: 'usb',
        adbTarget: 'emulator-5554'
      });
      expect(runtimeState.status).toBe('online');
      expect(runtimeState.ip).toBe('192.168.1.20');
      expect(runtimeState.port).toBe(5556);
      expect(runtimeState.connectionType).toBe('usb');
