const AudioFile = require('../../../../src/main/domain/entities/AudioFile');

describe('AudioFile', () => {
  let audioFile;

  beforeEach(() => {
    audioFile = new AudioFile({
      id: 'test-audio-id',
      name: 'test-audio',
      extension: 'mp3',
      sourceUrl: 'https://example.com/audio.mp3',
      storagePath: '/storage/test-audio.mp3',
      formatId: '140',
      abr: 192,
      codec: 'mp3',
