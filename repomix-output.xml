class LoggerContext {
    constructor(logger, source) {
        this._logger = logger;
        this._source = source;

        Object.freeze(this);
    }

    info(message, options = {}) {
        return this._logger.info(
            message,
            {
                ...options,
                source: this._source
            }
        );
