/* modal.css - نافذة معلومات الجهاز */
.device-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
}
.modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
}
.modal-content {
    position: relative;
    background: linear-gradient(145deg, #262626, #1f1f1f);
    border-radius: 32px;
    width: 90%;
    max-width: 400px;
    padding: 24px 20px 28px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    border: 1px solid #3a3a3a;
    animation: modalFadeIn 0.2s ease;
}
@keyframes modalFadeIn {
    from { opacity: 0; transform: scale(0.95);}
    to { opacity: 1; transform: scale(1);}
}
.modal-close {
    position: absolute;
    top: 16px;
    right: 20px;
    background: none;
    border: none;
    color: #a6a6a6;
    font-size: 28px;
    cursor: pointer;
}
.modal-close:hover { color: #ffffff; }
.modal-header { text-align: center; margin-bottom: 24px; }
.device-icon-large {
    width: 80px;
    height: 80px;
    margin: 0 auto 12px;
    background: linear-gradient(135deg, #1e6fd9, #0f4c9e);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}
.device-icon-large svg { width: 48px; height: 48px; stroke: white; }
.modal-device-name { font-size: 1.5rem; font-weight: 700; color: #ffffff; margin: 0; }
.modal-body { margin-bottom: 28px; }
.device-detail-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 10px 0;
    border-bottom: 1px solid #333;
}
.detail-label { font-size: 0.85rem; color: #a6a6a6; font-weight: 500; }
.detail-value { font-size: 0.9rem; color: #e0e0e0; font-weight: 500; text-align: left; direction: ltr; }
.detail-value.code { font-family: monospace; font-size: 0.8rem; background: #1a1a1a; padding: 4px 8px; border-radius: 8px; }
.status-badge-modal {
    display: inline-block;
    background-color: #2a2a2a;
    padding: 4px 12px;
    border-radius: 30px;
    font-size: 0.75rem;
    font-weight: 600;
}
.status-badge-modal.connected { background-color: #1b8755; color: white; }
.status-badge-modal.offline { background-color: #d32f2f; color: white; }
.status-badge-modal.discovered { background-color: #f57c00; color: white; }
.modal-actions { display: flex; gap: 16px; justify-content: center; }
.modal-btn {
    flex: 1;
    padding: 12px 16px;
    border: none;
    border-radius: 40px;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}
.modal-btn.primary { background-color: #1e6fd9; color: white; }
.modal-btn.primary:hover { background-color: #155bb0; transform: translateY(-2px); }
.modal-btn.danger { background-color: transparent; border: 1px solid #d32f2f; color: #d32f2f; }
.modal-btn.danger:hover { background-color: #d32f2f; color: white; }
@media (max-width: 500px) {
    .modal-content { width: 95%; padding: 20px 16px; }
    .modal-actions { flex-direction: column; }
}
