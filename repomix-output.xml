    flex-direction: column;
    align-items: center;
    width: 100%;
    margin-bottom: 28px;
}

.devices-capsule-pill {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 20px;
    background-color: #262626;
    padding: 16px 28px;
    border-radius: 100px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
    width: auto;
    max-width: 100%;
}

.offline-capsule {
    background-color: #1F1F1F;
    border: 1px solid #333333;
}

.device-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 18px;
    border-radius: 50px;
    background-color: #1A1A1A;
    cursor: pointer;
    transition: all 0.2s;
    border: 1px solid transparent;
}

.device-item:hover {
