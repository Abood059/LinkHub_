                const initialMemory = process.memoryUsage().heapUsed;
                
                service.startWirelessDiscovery();
                const callback = mockBonjour.find.mock.calls[0][1];
                
                // Emit 100 small events
                for (let i = 0; i < 100; i++) {
                    callback({
