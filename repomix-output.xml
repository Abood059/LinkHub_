    warn(message, options = {}) {
        return this._logger.warn(
            message,
            {
                ...options,
                source: this._source
            }
        );
    }

    error(message, options = {}) {
        return this._logger.error(
            message,
            {
                ...options,
                source: this._source
            }
        );
    }

    fatal(message, options = {}) {
        return this._logger.fatal(
            message,
            {
                ...options,
                source: this._source
            }
        );
    }

    report(options = {}) {
        return this._logger.report({
            ...options,
            source: this._source
        });
    }
}

module.exports = LoggerContext;
