describe('Integration Tests', () => {
    describe('DatabaseManager Integration Tests', () => {
        let tempDir;
        let dbManager;
        let dbPath;

        beforeEach(async () => {
            // Create a unique temporary directory for each test within the project
            tempDir = path.join(process.cwd(), 'temp-test-' + Date.now());
