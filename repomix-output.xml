     */
    addTask(task) {
        this.activeTasks.push(task);
    }

   

    toJSON() {
        return {
            ...super.toJSON()
            // لا توجد خصائص إضافية للحفظ حالياً، نكتفي ببيانات الأب
        };
    }

    static fromJSON(data) {
        return new MediaNode(data);
    }
}

