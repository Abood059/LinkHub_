    constructor({ id, deviceFriendlyName }) {
        // استدعاء الأب وتحديد النوع
        super({ id, deviceFriendlyName, type: 'MEDIA_NODE' });

        // قائمة المهام النشطة (روابط تحميل، تحويل صيغ، إلخ)
        this.activeTasks = []; 
