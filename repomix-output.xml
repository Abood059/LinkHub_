      expect(result[1]).toEqual({
        device: device2.toJSON(),
        runtimeState: runtimeState2.toJSON()
      });
      expect(result[2]).toEqual({
        device: device3.toJSON(),
        runtimeState: runtimeState3.toJSON()
      });
