    get name() {
        return this._name;
    }
    
    get instance() {
        return this._win;
    }
    
    show() {
        if (!this._win.isDestroyed()) {
            this._win.show();
        }
    }
    
    hide() {
        if (!this._win.isDestroyed()) {
            this._win.hide();
        }
    }
    
    close() {
        if (!this._win.isDestroyed()) {
            this._win.close();
        }
    }
    
    focus() {
        if (!this._win.isDestroyed()) {
            this._win.focus();
        }
    }
    
    send(channel, data) {
        if (!this._win.isDestroyed()) {
            this._win.webContents.send(channel, data);
        }
    }
    
    isDestroyed() {
        return this._win.isDestroyed();
    }
}

