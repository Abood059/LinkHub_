            expect(stateSyncService._currentState).toEqual(testState);
        });
    });

    describe('Edge cases', () => {
        test('should handle empty devices array', () => {
            stateSyncService._handleStateUpdate({
                devices: [],
                downloads: [],
                timestamp: 123456
            });

            expect(stateSyncService._currentState.devices).toEqual([]);
