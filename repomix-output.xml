/* base.css - الإعدادات الأساسية والمتغيرات */
*,
*::before,
*::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background-color: #1A1A1A;
    color: #FFFFFF;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
    min-height: 100vh;
    padding: clamp(16px, 4vw, 32px) clamp(16px, 5vw, 40px);
    -webkit-font-smoothing: antialiased;
}

.app-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 5vh, 48px);
}

/* أنيميشن fadeIn */
@keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px);}
    to { opacity: 1; transform: translateY(0);}
}

.tab-section {
    display: none;
    animation: fadeIn 0.25s ease;
}
.tab-section.active-section {
    display: block;
}
</file>

<file path="src/renderer/css/devices.css">
/* devices.css - أقسام الأجهزة وعناصرها (بمسافات متناسقة) */

/* الحاوية الخارجية لكل قائمة */
.devices-capsule-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin-bottom: 32px;  /* زيادة المسافة بين القائمتين */
}

/* الحاوية الداخلية (الكبسولة) */
.devices-capsule-pill {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 20px;            /* مسافة متساوية بين الأجهزة */
    background-color: #262626;
    padding: 20px 28px;    /* زيادة padding الداخلي */
    border-radius: 100px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
    width: auto;
    max-width: 100%;
    transition: all 0.2s ease;
}

/* الكبسولة الخاصة بالأجهزة غير المسجلة (لون مختلف قليلاً) */
.offline-capsule {
    background-color: #1F1F1F;
    border: 1px solid #333333;
}

/* عنصر الجهاز الواحد */
.device-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 20px;    /* زيادة padding أفقي وعمودي */
    border-radius: 60px;   /* أنحف قليلاً */
    background-color: #1A1A1A;
    cursor: pointer;
    transition: all 0.2s ease;
    border: 1px solid transparent;
}

.device-item:hover {
    background-color: #2E2E2E;
    transform: translateY(-2px);
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
}

/* الجهاز المحدد */
.device-item.selected {
    border: 1.5px solid #1E6FD9;
    background: linear-gradient(145deg, #1E2A3A, #0F1A2A);
    box-shadow: 0 0 12px rgba(30,111,217,0.5), inset 0 1px 0 rgba(255,255,255,0.05);
    transform: scale(1.02);
}

/* أيقونة الجهاز (الدائرة) */
.device-circle {
    width: 40px;          /* أكبر قليلاً */
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #0F0F0F;
    color: #FFFFFF;
    transition: 0.1s;
}

.device-circle svg {
    width: 22px;
    height: 22px;
    stroke: currentColor;
}

/* ألوان الحالة */
.status-connected .device-circle {
    color: #1B8755;
}
.status-offline .device-circle {
    color: #D32F2F;
}

/* اسم الجهاز */
.device-name {
    font-size: 0.9rem;    /* زيادة طفيفة */
    font-weight: 600;
    color: #FFFFFF;
    margin: 0;
}

/* التفاصيل الصغيرة (موديل/إصدار) */
.device-detail {
    font-size: 0.65rem;
    color: #A6A6A6;
    margin-top: 2px;
    line-height: 1.2;
    max-width: 140px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* شارة الحالة (متصل/غير متصل) */
.status-badge {
    font-size: 0.7rem;
    background-color: #2A2A2A;
    padding: 4px 10px;
    border-radius: 30px;
    color: #B0B0B0;
    font-weight: 500;
}

/* تنسيق عناوين الأقسام */
.section-subheading {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 12px;
    color: #E0E0E0;
    text-align: center;
}

.offline-sub {
    color: #A6A6A6;
}

/* حاوية الإدخال (لم تتغير كثيراً) */
.routing-input-container {
    display: flex;
    background-color: #262626;
    border-radius: 60px;
    padding: 6px;
    align-items: center;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
}

.input-url {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    padding: 12px 20px;
    color: #FFFFFF;
    font-size: 0.9rem;
    min-width: 180px;
}

.btn-route {
    border-radius: 50px;
    background-color: #1E6FD9;
    border: none;
    color: white;
    padding: 10px 28px;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    transition: 0.2s;
    white-space: nowrap;
}

.btn-route:hover {
    background-color: #155bb0;
    transform: scale(0.98);
}
</file>

<file path="src/renderer/css/downloads.css">
/* downloads.css - جدول التحميلات */
.downloads-card {
    background-color: #262626;
    border-radius: 32px;
    padding: 24px 20px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
    border: 1px solid #3A3A3A;
    overflow-x: auto;
}
.right-align { text-align: right; margin-bottom: 20px; }
.downloads-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 750px;
}
.downloads-table th {
    color: #A6A6A6;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 14px 8px;
    border-bottom: 2px solid #3A3A3A;
    text-align: right;
}
.downloads-table td {
    padding: 14px 8px;
    border-bottom: 1px solid #333333;
    vertical-align: middle;
    font-size: 0.85rem;
}
.file-name { font-weight: 600; color: #FFFFFF; }
.progress-wrapper { display: flex; align-items: center; gap: 10px; }
.progress-track {
    flex: 1;
    height: 6px;
    background-color: #1A1A1A;
    border-radius: 4px;
    overflow: hidden;
}
.progress-fill {
    height: 100%;
    background-color: #1E6FD9;
    border-radius: 4px;
    transition: width 0.2s, background-color 0.2s;
}
.progress-percentage { font-size: 0.7rem; font-weight: 600; color: #A6A6A6; min-width: 40px; text-align: left; }
.file-size, .download-speed { color: #C0C0C0; font-family: monospace; font-size: 0.75rem; }
.device-tag {
    background-color: #333333;
    color: #E0E0E0;
    padding: 4px 12px;
    border-radius: 30px;
    font-size: 0.7rem;
    font-weight: 500;
    display: inline-block;
}
</file>

